# Solver - Environment Configuration
# Copy this file to .env and fill in your values

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# AI Provider (OpenAI-compatible: DeepSeek, OpenAI, etc.)
AI_API_KEY=your_deepseek_api_key_here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_DEEP_MODEL=deepseek-reasoner

# Legacy OpenAI vars (still work if AI_* not set)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=sqlite+aiosqlite:///solver.db

# Scheduler
PROACTIVE_CHECK_INTERVAL_MINUTES=60
DEFAULT_CHECK_IN_HOUR=9

# Logging
LOG_LEVEL=INFO
