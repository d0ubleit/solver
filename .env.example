# Solver - Environment Configuration
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file (it is git-ignored).

# --- Telegram Bot ---
# Get a token from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- AI Provider (any OpenAI-compatible API) ---
# Defaults target DeepSeek. For OpenAI set AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_DEEP_MODEL=deepseek-reasoner

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///solver.db

# --- Proactive scheduler ---
PROACTIVE_CHECK_INTERVAL_MINUTES=60
DEFAULT_CHECK_IN_HOUR=9

# --- Logging ---
LOG_LEVEL=INFO
